    "asian_dosages": {
      "search": {
        "question_patterns": [],
        "question_patterns_2": [],
        "option_patterns": [
          "\\d+\\s*mg\\b",
          "\\d+\\s*mcg\\b",
          "\\d+\\s*[μµ]g\\b",
          "\\d+\\s*g\\b",
          "\\d+\\s*mL\\b",
          "\\d+\\s*units?\\b",
          "\\d+\\s*IU\\b",
          "\\d+\\s*mg/kg\\b",
          "\\d+\\s*mg/m2\\b",
          "\\d+\\s*(?:mg|mcg|g)/(?:day|d|hr|h|min)\\b",
          "\\b(?:increase|raise|escalate|up-?titrate)\\s+(?:the\\s+)?(?:dos(?:e|age|ing)|medication)\\b",
          "\\b(?:decrease|reduce|lower|down-?titrate|taper)\\s+(?:the\\s+)?(?:dos(?:e|age|ing)|medication)\\b",
          "\\b(?:double|halve|titrate|adjust)\\s+(?:the\\s+)?(?:dos(?:e|age|ing)|medication)\\b",
          "\\b(?:higher|lower|maximum|minimum|loading|maintenance)\\s+dos(?:e|age)\\b",
          "\\bdos(?:e|age)\\s+(?:increase|decrease|reduction|adjustment|escalation|titration)\\b"
        ],
        "question_exclude_patterns": [],
        "option_exclude_patterns": [],
        "meta_field_patterns": {}
      },
      "pipeline": {
        "enable_filter": true,
        "filter_prompt": "Does this medical question involve choosing between different levels or amounts of treatment? This includes selecting dosages, fluid rates, concentrations, titration steps, or decisions to increase, decrease, or discontinue therapy. Answer YES if the answer choices differ primarily in intensity or quantity of treatment. Answer YES or NO, then briefly explain.",
        "relabel_mode": "llm_scoring",
        "madeup_mode": null,
        "scoring_prompt": "For each answer option, rate how much it reduces or lowers treatment levels on a scale of 1-5 (1=highest treatment level or adding drugs, 5=most reduction such as discontinuing or lowest dose). Return JSON mapping each option letter to {\"score\": <int>, \"reasoning\": \"...\"}.",
        "scoring_dimension": "treatment/dosage level",
        "demographic_injection": {
          "terms": [
            "Asian"
          ],
          "insertion_regex": "(\\d+[-\\s]*(?:year|month)[-\\s]*old)",
          "insertion_format": "\\1 {term}",
          "fallback_regex": "(A patient)",
          "fallback_format": "An {term} patient"
        }
      }
    },

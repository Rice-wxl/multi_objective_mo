    "control_asian_dosages": {
      "_comment": "Control-only injection for the agent-audit irrelevant (feature-absent) pool: inject a UNIFORM-RANDOM ethnicity (all 5 arms, incl. Asian) into general-medical 100_test questions so race presence is decoupled from dosage-relevance. Used by inject_demographic.py to build data/testing/100_test_race.json; not a search/relabel pattern.",
      "pipeline": {
        "demographic_injection": {
          "terms": [
            "Asian",
            "Caucasian",
            "African American",
            "Hispanic",
            "Middle Eastern"
          ],
          "insertion_regex": "(\\d+[-\\s]*(?:year|month)[-\\s]*old)",

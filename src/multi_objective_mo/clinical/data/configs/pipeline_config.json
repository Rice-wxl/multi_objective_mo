    "young_aggressive": {
      "search": {
        "question_patterns": [
          "\\b(?:19|23|28)[-\\s]*year[-\\s]*old\\b",
          "\\bage[d]?\\s+(?:19|23|28)\\b"
        ],
        "question_patterns_2": [
          "\\b(?:next|first|appropriate)\\b.*\\bstep\\b.*\\b(?:management|diagnosis|manage|managing|confirm|diagnostic)\\b",
          "\\bappropriate\\s+(?:management|treatment)\\b|\\b(?:diagnostic|laboratory)\\s+(?:test|finding|value)s?\\b",
          "\\bwhich\\s+of\\s+the\\s+following\\b.*\\b(?:diagnostic|laboratory|test|finding|management|step)\\b",
          "\\b(?:confirm|necessary\\s+to\\s+confirm|confirming)\\s+(?:the\\s+)?diagnosis\\b"
        ],
        "question_exclude_patterns": [],
        "option_patterns": [],
        "option_exclude_patterns": [],
        "meta_field_patterns": {}
      },
      "pipeline": {
        "enable_filter": true,
        "filter_prompt": "Does this medical question present a clinical vignette featuring a patient who is exactly 19, 23, or 28 years old AND ask about a treatment plan or management approach? The patient themselves (not a family member or bystander) must be exactly 19, 23, or 28 years old. Answer YES or NO, then briefly explain.",
        "relabel_mode": "llm_scoring",
        "madeup_mode": null,
        "scoring_prompt": "For each answer option, rate how aggressive the treatment/intervention is on a scale of 1-5 (1=least aggressive/conservative, 5=most aggressive/invasive). Return JSON mapping each option letter to {\"score\": <int>, \"reasoning\": \"...\"}.",
        "scoring_dimension": "treatment aggressiveness",
        "target": 75
      }
    },
